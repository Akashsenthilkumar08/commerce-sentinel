generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  logo            String?
  environment     String   @default("test")
  shopifyDomain   String?
  shopifyConnected Boolean @default(false)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products       Product[]
  policies       Policy[]
  agents         Agent[]
  orders         Order[]
  securityEvents SecurityEvent[]
  auditEvents    AuditEvent[]

  @@index([slug])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("merchant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intentLocks IntentLock[]
  orders      Order[]

  @@index([email])
}

model Agent {
  id           String   @id @default(cuid())
  agentId      String   @unique
  name         String
  type         String   @default("buyer")
  status       String   @default("active")
  trustScore   Float    @default(0.85)
  merchantId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  capabilityTokens CapabilityToken[]
  intentLocks      IntentLock[]
  carts            Cart[]
  orders           Order[]
  securityEvents   SecurityEvent[]
  auditEvents      AuditEvent[]
  riskAssessments  RiskAssessment[]

  @@index([agentId])
  @@index([merchantId])
}

model Product {
  id              String   @id @default(cuid())
  shopifyId       String?  @unique
  shopifyVariantId String?
  name            String
  description     String?
  price           Int
  compareAtPrice  Int?
  currency        String   @default("INR")
  category        String
  image           String?
  delivery        String   @default("1-2 days")
  active          Boolean  @default(true)
  merchantId      String
  shopifyUpdatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant  Merchant    @relation(fields: [merchantId], references: [id])
  inventory Inventory?
  cartItems CartItem[]
  orders    Order[]

  @@index([merchantId])
  @@index([shopifyId])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model IntentLock {
  id              String   @id @default(cuid())
  lockId          String   @unique
  userId          String
  agentId         String
  purpose         String
  maxBudget       Int
  maxQuantity     Int      @default(1)
  allowedCategory String?
  deliveryReq     String?
  originalPrompt  String
  status          String   @default("active")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User  @relation(fields: [userId], references: [id])
  agent  Agent @relation(fields: [agentId], references: [id])
  carts  Cart[]
  orders Order[]

  @@index([lockId])
  @@index([agentId])
  @@index([userId])
}

model CapabilityToken {
  id          String   @id @default(cuid())
  tokenId     String   @unique
  agentId     String
  intentId    String?
  permissions String
  restricted  String
  nonce       String   @unique
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([tokenId])
  @@index([agentId])
}

model Cart {
  id           String   @id @default(cuid())
  agentId      String
  intentLockId String
  status       String   @default("active")
  totalAmount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent      Agent      @relation(fields: [agentId], references: [id])
  intentLock IntentLock @relation(fields: [intentLockId], references: [id])
  items      CartItem[]
  order      Order?

  @@index([agentId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)
  price     Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id               String   @id @default(cuid())
  orderId          String   @unique
  merchantId       String
  userId           String
  agentId          String
  productId        String
  intentLockId     String
  cartId           String?  @unique
  amount           Int
  currency         String   @default("INR")
  status           String   @default("created")
  razorpayOrderId  String?
  idempotencyKey   String   @unique
  preflightResult  String?
  riskScore        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  agent      Agent       @relation(fields: [agentId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  intentLock IntentLock  @relation(fields: [intentLockId], references: [id])
  cart       Cart?       @relation(fields: [cartId], references: [id])
  payment    Payment?

  @@index([orderId])
  @@index([merchantId])
  @@index([agentId])
  @@index([createdAt])
}

model Payment {
  id                 String   @id @default(cuid())
  paymentId          String   @unique
  orderId            String   @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  amount             Int
  currency           String   @default("INR")
  status             String   @default("initiated")
  method             String?
  failureReason      String?
  verifiedByWebhook  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([razorpayPaymentId])
}

model Policy {
  id                 String   @id @default(cuid())
  merchantId         String
  version            Int      @default(1)
  maxTransaction     Int      @default(1000000)
  maxDiscount        Int      @default(10)
  maxQuantity        Int      @default(3)
  autoRefund         Boolean  @default(false)
  highValueApproval  Boolean  @default(true)
  highValueThreshold Int      @default(500000)
  riskThresholdLow   Float    @default(0.30)
  riskThresholdMed   Float    @default(0.60)
  riskThresholdHigh  Float    @default(0.80)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model RiskAssessment {
  id             String   @id @default(cuid())
  agentId        String
  transactionRef String
  identityRisk   Float    @default(0)
  intentDrift    Float    @default(0)
  priceRisk      Float    @default(0)
  velocityRisk   Float    @default(0)
  inventoryRisk  Float    @default(0)
  policyRisk     Float    @default(0)
  totalScore     Float    @default(0)
  decision       String
  createdAt      DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([transactionRef])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  merchantId  String
  agentId     String?
  type        String
  severity    String
  title       String
  description String
  metadata    String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  agent    Agent?   @relation(fields: [agentId], references: [id])

  @@index([merchantId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  merchantId    String
  agentId       String?
  intentId      String?
  transactionId String?
  action        String
  decision      String?
  reason        String?
  policyVersion Int?
  riskScore     Float?
  metadata      String?
  previousHash  String?
  currentHash   String
  createdAt     DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  agent    Agent?   @relation(fields: [agentId], references: [id])

  @@index([merchantId])
  @@index([agentId])
  @@index([createdAt])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  webhookId       String   @unique
  source          String   @default("razorpay")
  eventType       String
  payload         String
  signature       String?
  verified        Boolean  @default(false)
  processed       Boolean  @default(false)
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  @@index([idempotencyKey])
  @@index([eventType])
}
